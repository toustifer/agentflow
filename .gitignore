# Python artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# Node / JS artifacts
node_modules/
*.tgz

# Credentials, tokens, and personal identity
.zhiji_*
*.jwt
*.token
*.env
*.env.*
*cookie*
*credential*
.mycompany/
.claude/
.agent-hub/

# Binary executables and releases
*.exe
*.exe~
bin/
dist/
.release-*/
# Release binaries: the exact <os>-<arch> names produced by
# scripts/build-release.{sh,ps1} (see skills/agentflow/SETUP.md).
# NOTE: this used to be a blanket `agentflow-*-*`, which also matched skill
# directories such as skills/agentflow/agents/agentflow-dev-leader/ and
# silently ignored every file added there. Keep this list pinned to the real
# artifacts instead of widening it.
agentflow-windows-amd64*
agentflow-linux-amd64*
agentflow-darwin-amd64*
agentflow-darwin-arm64*

# Intermediate build and test scratchpads
.tmp*
*-smoke*
*-fixed*
mcp-fixed-verification.json
scripts/paper_eval/interruption_testbed/
scripts/paper_eval/native_agent_sandbox/
scripts/paper_eval/real_testbed/

# LaTeX build intermediates and private research papers
docs/paper/
docs/surveys/
docs/reader.html
scripts/paper_eval/
